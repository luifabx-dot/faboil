// ── NAV ────────────────────────────────────────────
function go(id,btn){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('on'));
  document.getElementById('p-'+id).classList.add('on');
  document.querySelectorAll('.bn').forEach(b=>b.classList.remove('on'));
  if(btn)btn.classList.add('on');
  if(id==='turni')calRender();
  if(id==='inserimento'){initInserimento();rInserimenti()}
  if(id==='riepilogo')rInit();
}

function initApp(){
  calOggi();
  initInserimento();
  rInit();
}

// ── CALENDARIO SETTIMANALE ─────────────────────────
const MESI=['gen','feb','mar','apr','mag','giu','lug','ago','set','ott','nov','dic'];
const GG=['Domenica','Lunedì','Martedì','Mercoledì','Giovedì','Venerdì','Sabato'];
const GG_S=['Dom','Lun','Mar','Mer','Gio','Ven','Sab'];
let calStart=null;
function calGetLun(d){const dt=new Date(d);const day=dt.getDay()||7;dt.setDate(dt.getDate()-day+1);dt.setHours(12,0,0,0);return dt}
function calDs(d){return d.toISOString().slice(0,10)}
function calOggi(){calStart=calGetLun(new Date());calRender()}
function calPrev(){calStart.setDate(calStart.getDate()-7);calRender()}
function calNext(){calStart.setDate(calStart.getDate()+7);calRender()}

function calRender(){
  const giorni=[...Array(7)].map((_,i)=>{const d=new Date(calStart);d.setDate(calStart.getDate()+i);return calDs(d)});
  const da=new Date(giorni[0]+'T12:00'),a=new Date(giorni[6]+'T12:00');
  document.getElementById('cal-label').textContent=`${da.getDate()} ${MESI[da.getMonth()]} — ${a.getDate()} ${MESI[a.getMonth()]} ${a.getFullYear()}`;
  const tod=today();
  const turni=(S.turni_sched||[]).filter(t=>t.data>=giorni[0]&&t.data<=giorni[6]);
  let html='';
  giorni.forEach(dt=>{
    const d=new Date(dt+'T12:00'),isOggi=dt===tod;
    const dayT=turni.filter(t=>t.data===dt).sort((a,b)=>{
      const ord={Mattina:0,Pomeriggio:1,Notte:2,Personalizzato:3,Riposo:4};
      return(ord[a.tipo]||0)-(ord[b.tipo]||0);
    });
    html+=`<div class="week-day">
      <div class="week-day-header${isOggi?' oggi':''}">
        <span class="week-day-nome">${GG_S[d.getDay()]}</span>
        <span class="week-day-data">${d.getDate()} ${MESI[d.getMonth()]}</span>
        ${isOggi?'<span style="margin-left:auto;font-size:.65rem;font-weight:700;color:var(--accent);background:var(--accent-bg);padding:.1rem .45rem;border-radius:6px">OGGI</span>':''}
      </div>
      <div class="week-turni">`;
    if(!dayT.length){html+=`<div class="no-turni">Nessun turno</div>`}
    else dayT.forEach(t=>{
      const ic=t.tipo==='Mattina'?'☀️':t.tipo==='Pomeriggio'?'🌤':t.tipo==='Notte'?'🌙':t.tipo==='Riposo'?'🛌':'⏱';
      const orario=t.tipo==='Personalizzato'?` ${t.oraInizio}–${t.oraFine}`:t.tipo!=='Riposo'&&(t.oraInizio)?` ${t.oraInizio}–${t.oraFine}`:'';
      html+=`<div class="turno-row" style="padding:.5rem 0">
        <span class="turno-pill ${t.tipo}">${ic} ${t.tipo==='Personalizzato'?'Libero':t.tipo}</span>
        <span style="font-weight:700;font-size:.85rem;flex:1;margin-left:.5rem">${bNome(t.badge)}</span>
        <span style="font-family:var(--mono);font-size:.72rem;color:var(--muted)">${orario}</span>
        ${t.note?`<span class="turno-note" style="width:100%;margin-top:.15rem">📝 ${t.note}</span>`:''}
      </div>`;
    });
    html+='</div></div>';
  });
  document.getElementById('week-list').innerHTML=html||'<div class="empty"><div class="empty-ic">🗓</div><p>Nessun turno questa settimana</p></div>';
}

// ── INSERIMENTO ────────────────────────────────────
function initInserimento(){
  const t=today();
  if(!document.getElementById('drop-data').value)document.getElementById('drop-data').value=t;
  if(!document.getElementById('pos-data').value)document.getElementById('pos-data').value=t;
  const opts=optsHtml('— Seleziona —');
  document.getElementById('drop-badge').innerHTML=opts;
  document.getElementById('pos-badge').innerHTML=opts;
  // Pre-seleziona operatore loggato
  if(currentBadge){
    document.getElementById('drop-badge').value=currentBadge;
    document.getElementById('pos-badge').value=currentBadge;
  }
}
function dropManuale(){
  const bdg=document.getElementById('drop-badge').value,data=document.getElementById('drop-data').value;
  const imp=parseFloat(document.getElementById('drop-imp').value)||0;
  if(!bdg||!data||!imp){showSt('drop-status','Compila tutti i campi','err');return}
  if(!S.drops[bdg])S.drops[bdg]={};
  S.drops[bdg][data]=Math.round(((S.drops[bdg][data]||0)+imp)*100)/100;
  sv();showSt('drop-status',`✅ Drop ${fmt(imp)} salvato per ${bNome(bdg)} · ${fd(data)}`,'ok');
  document.getElementById('drop-imp').value='';rInserimenti();
}
function posManuale(){
  const bdg=document.getElementById('pos-badge').value,data=document.getElementById('pos-data').value;
  const pos=parseFloat(document.getElementById('pos-imp').value)||0;
  const addeb=parseFloat(document.getElementById('pos-addeb').value)||0;
  const mon=parseFloat(document.getElementById('pos-mon').value)||0;
  if(!bdg||!data){showSt('pos-status','Seleziona operatore e data','err');return}
  if(!S.pos_d[bdg])S.pos_d[bdg]={};
  S.pos_d[bdg][data]={pos,addeb,mon};sv();
  showSt('pos-status',`✅ POS ${fmt(pos)} salvato per ${bNome(bdg)} · ${fd(data)}`,'ok');
  ['pos-imp','pos-addeb','pos-mon'].forEach(id=>document.getElementById(id).value='');
  rInserimenti();
}
function rInserimenti(){
  const el=document.getElementById('ins-list');
  const items=[];
  Object.entries(S.drops||{}).forEach(([b,dates])=>Object.entries(dates).forEach(([dt,v])=>items.push({tipo:'drop',badge:b,data:dt,label:`🪙 Drop — ${bNome(b)}`,val:v,color:'var(--blue)'})));
  Object.entries(S.pos_d||{}).forEach(([b,dates])=>Object.entries(dates).forEach(([dt,v])=>items.push({tipo:'pos',badge:b,data:dt,label:`💳 POS — ${bNome(b)}`,val:v.pos,color:'var(--text)',sub:`Add: ${fmt(v.addeb)} · Mon: ${fmt(v.mon)}`})));
  items.sort((a,b)=>b.data.localeCompare(a.data));
  if(!items.length){el.innerHTML='<div class="empty"><div class="empty-ic">📋</div><p>Nessun inserimento ancora</p></div>';return}
  el.innerHTML=items.slice(0,30).map(it=>`
    <div class="scan-item"><div><div class="name">${it.label}</div>
      <div style="font-size:.7rem;color:var(--muted);font-family:var(--mono)">${fd(it.data)}${it.sub?' · '+it.sub:''}</div></div>
      <span class="amt" style="color:${it.color}">${fmt(it.val)}</span>
    </div>`).join('');
}

// ── RIEPILOGO ──────────────────────────────────────
function rInit(){
  if(!document.getElementById('r-da').value)document.getElementById('r-da').value=today();
  if(!document.getElementById('r-a').value)document.getElementById('r-a').value=today();
}
function sumRange(map,badge,da,a){
  let tot=0;
  const src=badge?(map[badge]||{}):Object.values(map).reduce((acc,bd)=>{Object.entries(bd).forEach(([dt,v])=>{acc[dt]=(acc[dt]||0)+v});return acc},{});
  Object.entries(src).forEach(([dt,v])=>{if(dt>=da&&dt<=a)tot+=v});
  return Math.round(tot*100)/100;
}
function sumPosField(badge,da,a,field){
  let tot=0;
  const src=badge?(S.pos_d[badge]||{}):Object.values(S.pos_d).reduce((acc,bd)=>{
    Object.entries(bd).forEach(([dt,v])=>{if(!acc[dt])acc[dt]={pos:0,addeb:0,mon:0};acc[dt].pos+=(v.pos||0);acc[dt].addeb+=(v.addeb||0);acc[dt].mon+=(v.mon||0)});return acc},{});
  Object.entries(src).forEach(([dt,v])=>{if(dt>=da&&dt<=a)tot+=(v[field]||0)});
  return Math.round(tot*100)/100;
}
function rCalc(){
  const da=document.getElementById('r-da').value,a=document.getElementById('r-a').value;
  if(!da||!a)return;
  const badges=Object.keys(S.badges).filter(b=>{
    return Object.keys(S.erogato[b]||{}).some(dt=>dt>=da&&dt<=a)||
           Object.keys(S.drops[b]||{}).some(dt=>dt>=da&&dt<=a)||
           Object.keys(S.pos_d[b]||{}).some(dt=>dt>=da&&dt<=a);
  });
  if(!badges.length){
    document.getElementById('r-stats').style.display='none';
    document.getElementById('r-empty').style.display='';
    document.getElementById('r-empty').innerHTML='<div class="empty-ic">🔍</div><p>Nessun dato per questo periodo</p>';
    return;
  }
  document.getElementById('r-empty').style.display='none';
  document.getElementById('r-stats').style.display='';
  let tEr=0,tDr=0,tPos=0,tAdd=0,tMon=0,rows='';
  badges.sort((a,b)=>bNome(a).localeCompare(bNome(b))).forEach(b=>{
    const er=sumRange(S.erogato,b,da,a),dr=sumRange(S.drops,b,da,a);
    const pos=sumPosField(b,da,a,'pos'),add=sumPosField(b,da,a,'addeb'),mon=sumPosField(b,da,a,'mon');
    const inc=Math.round((dr+pos+add+mon)*100)/100,diff=Math.round((inc-er)*100)/100;
    const dc=diff<-.5?'neg':diff>.5?'pos':'zero';
    const isMe=b===currentBadge;
    tEr+=er;tDr+=dr;tPos+=pos;tAdd+=add;tMon+=mon;
    rows+=`<tr class="${diff<-.5?'ammanco':''}" style="${isMe?'background:var(--accent-bg)':''}">
      <td><strong>${bNome(b)}</strong>${isMe?' <span style="font-size:.65rem;color:var(--accent)">● tu</span>':''}</td>
      <td style="color:var(--accent)">${fmt(er)}</td><td>${fmt(dr)}</td><td>${fmt(pos)}</td>
      <td><strong>${fmt(inc)}</strong></td><td class="${dc}">${diff>=0?'+':''}${fmt(diff)}</td></tr>`;
  });
  document.getElementById('r-tbody').innerHTML=rows;
  const tInc=Math.round((tDr+tPos+tAdd+tMon)*100)/100,tDiff=Math.round((tInc-tEr)*100)/100;
  const tdc=tDiff<-.5?'neg':tDiff>.5?'pos':'zero';
  document.getElementById('r-tfoot').innerHTML=`<tr><td>TOT.</td><td style="color:var(--accent)">${fmt(tEr)}</td><td>${fmt(tDr)}</td><td>${fmt(tPos)}</td><td>${fmt(tInc)}</td><td class="${tdc}">${tDiff>=0?'+':''}${fmt(tDiff)}</td></tr>`;
  const dfc=tDiff<-.5?'red':tDiff>.5?'green':'';
  document.getElementById('r-boxes').innerHTML=`
    <div class="stat-box"><div class="stat-label">Erogato</div><div class="stat-val acc">${fmt(tEr)}</div></div>
    <div class="stat-box"><div class="stat-label">Drop</div><div class="stat-val blue">${fmt(tDr)}</div></div>
    <div class="stat-box"><div class="stat-label">POS</div><div class="stat-val">${fmt(tPos)}</div></div>
    <div class="stat-box"><div class="stat-label">Differenza</div><div class="stat-val ${dfc}">${tDiff>=0?'+':''}${fmt(tDiff)}</div></div>`;
}

// ── JSONBIN SYNC ───────────────────────────────────
function jbEnabled(){return JB_KEY&&JB_KEY.length>10}
async function jbPull(){
  if(!jbEnabled()||!JB_BIN)return;
  try{
    const r=await fetch(`https://api.jsonbin.io/v3/b/${JB_BIN}/latest`,{headers:{'X-Master-Key':JB_KEY}});
    const d=await r.json();if(!d.record)return;
    applyData(d.record);
    try{localStorage.setItem('gc5',JSON.stringify(S))}catch(e){}
    _jbLastHash=JSON.stringify(d.record).slice(0,200);
    jbStatusUpdate('ok');
    if(currentBadge){const act=document.querySelector('.page.on');if(act){if(act.id==='p-turni')calRender();if(act.id==='p-riepilogo')rCalc();}}
  }catch(e){console.warn('jbPull:',e)}
}
async function jbSave(){
  if(!jbEnabled()||!JB_BIN)return;
  try{
    await fetch(`https://api.jsonbin.io/v3/b/${JB_BIN}`,{method:'PUT',headers:{'Content-Type':'application/json','X-Master-Key':JB_KEY},body:JSON.stringify(S)});
    jbStatusUpdate('ok');
  }catch(e){jbStatusUpdate('err');console.warn('jbSave:',e)}
}
async function jbPoll(){
  if(!jbEnabled()||!JB_BIN)return;
  try{
    const r=await fetch(`https://api.jsonbin.io/v3/b/${JB_BIN}/latest`,{headers:{'X-Master-Key':JB_KEY}});
    const d=await r.json();if(!d.record)return;
    const hash=JSON.stringify(d.record).slice(0,200);
    if(hash===_jbLastHash)return;
    _jbLastHash=hash;
    applyData(d.record);
    try{localStorage.setItem('gc5',JSON.stringify(S))}catch(e){}
    if(currentBadge){
      const act=document.querySelector('.page.on');
      if(act){
        if(act.id==='p-turni')calRender();
        if(act.id==='p-riepilogo')rCalc();
        if(act.id==='p-inserimento')rInserimenti();
      }
    }
  }catch(e){}
}
function jbStatusUpdate(state){
  const el=document.getElementById('sync-badge');if(!el)return;
  if(!jbEnabled()||!JB_BIN){el.textContent='💾 locale';return}
  if(state==='ok'){el.textContent='☁️ sync';el.style.color='#16a34a';el.style.background='rgba(34,197,94,.15)'}
  else if(state==='err'){el.textContent='⚠️ errore';el.style.color='#dc2626';el.style.background='rgba(239,68,68,.1)'}
}

// ── BOOT ───────────────────────────────────────────
ld();
setTimeout(()=>jbStatusUpdate(),500);
